# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=
MONGO_DB=

# Redis (BullMQ)
REDIS_HOST=
REDIS_PORT=6379
REDIS_KEY=

# Webhook
WEBHOOK_SECRET=

# Legacy webhook path (set true to keep writing LatestNotification via old worker)
USE_LEGACY_WEBHOOK=false

# ChangeDetection API (HTML snapshot fetch)
CHANGEDETECTION_API_URL=
CHANGEDETECTION_API_TOKEN=
PIPELINE_HTML_TIMEOUT_MS=4000

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ARTIFACT_SIZE_THRESHOLD_BYTES=102400

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Choose one: openrouter | google
AI_PROVIDER=openrouter

# OpenRouter (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Google GenAI (used when AI_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_VISION_MODEL=gemini-2.0-flash

# ─── Pipeline Tuning ───────────────────────────────────────────────────────────
# AI call timeout in ms (applies to both OpenRouter and Google — default 30s)
AI_TIMEOUT_MS=30000

# PDF download timeout in ms (default 15s)
PDF_TIMEOUT_MS=15000

# Max PDF file size in bytes (default 10MB)
PDF_MAX_BYTES=10485760

# Max PDF extracted text sent to AI (default 15000 chars)
PDF_TEXT_LIMIT=15000

# BullMQ worker concurrency (default 5)
WEBHOOK_WORKER_CONCURRENCY=5